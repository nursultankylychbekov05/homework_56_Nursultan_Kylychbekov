@model IEnumerable<WebApplication1.Models.Brand>

@{
    ViewData["Title"] = "Бренды";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список брендов</h2>
    <a asp-action="Create" class="btn btn-primary">Добавить бренд</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
    <tr>
        <th>Название</th>
        <th>Email</th>
        <th>Дата основания</th>
        <th>Действия</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Email</td>
            <td>@item.FoundedDate.ToString("dd.MM.yyyy")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Редактировать</a>
            </td>
        </tr>
    }
    </tbody>
</table>